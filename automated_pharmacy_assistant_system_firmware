// WiFi credentials
const char* ssid = "";
const char* password = "";

// rest api
const char* apiEndpoint = "api_url";

StaticJsonDocument<512> prescriptionData;

// Task handles for dual core operation
TaskHandle_t Task1;  
TaskHandle_t Task2;  

void processTypedValue();
void svo1(int dly);
void svo2(int dly);
void svo3(int dly);
void svo4(int dly);
