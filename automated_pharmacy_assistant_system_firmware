const int motorPin1 =25;
const int motorPin2 =26;
const int motorPin3 =27;
const int motorPin4 =14;
const int convmotorPin =13;
const int buzzerPin = 2;
//const int irSensorPin = 2;


// Queue for passing data between cores
QueueHandle_t prescriptionQueue;

// Struct for prescription data
struct PrescriptionData {
  char uid[20];
  char type[10];
  int Metformin;
  int Glimepiride;
  int Vildagliptin;
  int Pioglitazone;
  char doctor[30];
  char date[30]; 
  bool fulfilled;
};

void setup() {
  Serial.begin(115200);
  pinMode(motorPin1, OUTPUT);
  pinMode(motorPin2, OUTPUT);
  pinMode(motorPin3, OUTPUT);
  pinMode(motorPin4, OUTPUT);
  pinMode(BUILTIN_LED, OUTPUT);
  pinMode(convmotorPin, OUTPUT);
  pinMode(buzzerPin, OUTPUT);
  pinMode(34, INPUT);
  pinMode(35, INPUT);
  pinMode(36, INPUT);
  pinMode(39, INPUT);
  
  lcd.init();
  // Turn on the backlight
  lcd.backlight();
  lcd.setCursor(0, 0);
  lcd.print("DISPENSER-ON");

  // Create queue for inter-core communication
  prescriptionQueue = xQueueCreate(5, sizeof(PrescriptionData));
  if (prescriptionQueue == NULL) {
    Serial.println("Error creating the queue");
    return;
  }
  
  // Core 0  - backend communication with api 
  xTaskCreatePinnedToCore(
    handlePrescription,    
    "handlePrescription",  
    8192,             
    NULL,             
    1,                
    &Task1,           
    0                 
  );
  
  // Core 1 handling DataProcessingTask-harware controlling
  xTaskCreatePinnedToCore(
    dataProcessingTask,    
    "DataProcessingTask",  
    8192,                  
    NULL,                  
    1,                     
    &Task2,                
    1                      
  );
}

void loop() {

  vTaskDelay(1000 / portTICK_PERIOD_MS);

}

//task of core 1
void dataProcessingTask(void * parameter) {
  PrescriptionData receivedData;
  
  Serial.println("Data processing task started on Core 1");
  
  
  for(;;) {
    
    if (xQueueReceive(prescriptionQueue, &receivedData, portMAX_DELAY) == pdPASS) {
      // monitoring que
      Serial.println("------ Processing Prescription on Core 1 ------");
      Serial.println("Patient ID: " + String(receivedData.uid));
      Serial.println("Type: " + String(receivedData.type));
      Serial.println("Metformin: " + String(receivedData.Metformin));
      Serial.println("Insulin: " + String(receivedData.Glimepiride));
      Serial.println("Medication3: " + String(receivedData.Vildagliptin));
      Serial.println("Medication4: " + String(receivedData.Pioglitazone));
      Serial.println("Doctor: " + String(receivedData.doctor));
      Serial.println("Date: " + String(receivedData.date));
      Serial.println("Fulfilled: " + String(receivedData.fulfilled ? "Yes" : "No"));
      Serial.println("-------------------------------------------");
      
      lcd.clear();
      display(String(receivedData.uid),"processing");//displayind patient id
      
      int quantity1=receivedData.Metformin;
      int quantity2=receivedData.Glimepiride;
      int quantity3=receivedData.Vildagliptin;
      int quantity4=receivedData.Pioglitazone;

      beep1000(1);
      digitalWrite(convmotorPin, HIGH);
      svo1(String(receivedData.uid),quantity1*1000);
      svo2(String(receivedData.uid),quantity2*1000);
      svo3(String(receivedData.uid),quantity3*1000);
      svo4(String(receivedData.uid),quantity4*1000);
      digitalWrite(convmotorPin, LOW);
      lcd.clear();
      display(String(receivedData.uid),"dispensed");
      beep1000(1);
      //monitoring
      Serial.println(quantity1);
      Serial.println(quantity2);
      Serial.println(quantity3);
      Serial.println(quantity4);
    

    }
  }
}

//task of core 0
void handlePrescription(void * parameter) {

  
  WiFi.begin(ssid, password);
  Serial.print("Connecting to Wi-Fi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi connected!");



  while (1) {
 

    if (WiFi.status() == WL_CONNECTED) {
    
      WiFiClientSecure client;
      client.setInsecure(); 
      HTTPClient http;
    
      String url = String(apiEndpoint);
      http.begin(client, url);
    
      int httpCode = http.POST("{}");
      Serial.println("HTTP Response code: " + String(httpCode));
      Serial.println("Requesting: " + url);

      if (httpCode == 200) {
        String payload = http.getString();
        Serial.println("Received payload: " + payload);
        
        StaticJsonDocument<1024> doc; 
        
        DeserializationError error = deserializeJson(doc, payload);
    
        if (!error) {
          JsonArray dataArray = doc["prescriptions"].as<JsonArray>(); 

          if (dataArray.size() > 0) {
           JsonObject prescriptionData = dataArray[0]; 
           PrescriptionData data;
    
           
           strlcpy(data.uid, prescriptionData["uid"] | "", sizeof(data.uid));
           strlcpy(data.type, prescriptionData["type"] | "diabetes", sizeof(data.type));
           data.Metformin = prescriptionData["Metformin"] | 0;
           data.Glimepiride = prescriptionData["Glimepiride"] | 0;
           data.Vildagliptin = prescriptionData["Vildagliptin"] | 0;
           data.Pioglitazone = prescriptionData["Pioglitazone"] | 0;
           strlcpy(data.doctor, prescriptionData["doctor"] | "", sizeof(data.doctor));
           strlcpy(data.date, prescriptionData["date"] | "", sizeof(data.date));
           data.fulfilled = prescriptionData["fulfilled"] | false;
    
           // Send data to processing queue
           if (xQueueSend(prescriptionQueue, &data, portMAX_DELAY) != pdPASS) {
              Serial.println("Failed to send data to queue");
              return;
            }
    
          } else {
            Serial.println("Error: JSON array is empty!");
          }
        } else {
          Serial.println("JSON parsing failed! Error: " + String(error.c_str()));
        }
      } else {
          Serial.println("Error on HTTP request");
      }
      http.end();
   
    } else {
      Serial.println("WiFi disconnected!");
    }
 
  }

}


//for displaying into the lcd
void display(String msg1,String msg2){
  lcd.setCursor(0, 0);
  lcd.print(msg1);

  lcd.setCursor(0, 1); 
  lcd.print(msg2);
}

//for this functions for buzzering


void beep500(int numBeeps) {
  Serial.println("beep500");
  for (int i = 0; i < numBeeps; i++) {
    tone(buzzerPin, 1000); 
    vTaskDelay(150 / portTICK_PERIOD_MS);
    noTone(buzzerPin);
    vTaskDelay(150 / portTICK_PERIOD_MS); 
  }
}
 
void beep1000(int numBeeps) {
  Serial.println("beep1000");
  for (int i = 0; i < numBeeps; i++) {
    tone(buzzerPin, 1000); 
    vTaskDelay(1000 / portTICK_PERIOD_MS);
    noTone(buzzerPin);
    vTaskDelay(1000 / portTICK_PERIOD_MS);
  }
}

void longbeep(int numBeeps) {
  Serial.println("2000beep");
  for (int i = 0; i < numBeeps; i++) {
    tone(buzzerPin, 1000); 
    vTaskDelay(2000 / portTICK_PERIOD_MS);
    noTone(buzzerPin);
    vTaskDelay(2000 / portTICK_PERIOD_MS);
  }
}

