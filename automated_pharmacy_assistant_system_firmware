//functions for dispenser control

void svo1(String id,int dly) {
  Serial.println("pin1");
  Serial.println(dly);
  if (ir(34)==1){
  digitalWrite(motorPin1, HIGH);
  lcd.clear();
  display(id,"metaformin: "+dly);
  digitalWrite(motorPin2, LOW);
  digitalWrite(motorPin3, LOW);
  digitalWrite(motorPin4, LOW);
  digitalWrite(BUILTIN_LED, HIGH);

  vTaskDelay(dly / portTICK_PERIOD_MS);
  digitalWrite(BUILTIN_LED, LOW);

  digitalWrite(motorPin1, LOW);
  }else {
  Serial.println("med1 low");
  lcd.clear();
  display(id+" failed","med3: empty");
  longbeep(2);
  }

  
}
void svo2(String id,int dly) {
  Serial.println("pin2");
  Serial.println(dly);
